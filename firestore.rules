rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerifiedAdminEmail() {
      return isSignedIn() &&
        'email' in request.auth.token && (
          (request.auth.token.email == 'abdulbasitshwankareem@gmail.com' &&
            request.auth.token.email_verified == true) ||
          request.auth.token.email in [
            'admin1@dxppost.com',
            'admin2@dxppost.com',
            'owner@dxppost.com',
            'owner2@dxppost.com',
            'owner3@dxppost.com'
          ]
        );
    }

    function isCompanyOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'OWNER' &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isVerifiedAdminEmail() ||
        isCompanyOwner() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function hasValidAdminSecretCode(data) {
      return 'adminCode' in data && data.adminCode is string && data.adminCode == 'DXPPOST' &&
             (!('adminUsername' in data) || (data.adminUsername is string && data.adminUsername == 'DXP'));
    }

    // 3. Schema Validation Blueprints
    function isValidStaffMember(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.companyCode is string && data.companyCode == 'DXP_POST' &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.phone is string && data.phone.size() <= 30 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('adminUsername' in data) || (data.adminUsername is string && data.adminUsername.size() <= 30)) &&
             (!('adminCode' in data) || (data.adminCode is string && data.adminCode.size() <= 30)) &&
             data.role is string && (data.role == 'OWNER' || data.role == 'DRIVER') &&
             data.vehicleInfo is string && data.vehicleInfo.size() <= 80 &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDeliveryOrder(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.companyCode is string && data.companyCode == 'DXP_POST' &&
             data.trackingCode is string && data.trackingCode.size() >= 1 && data.trackingCode.size() <= 40 &&
             data.senderName is string && data.senderName.size() <= 80 &&
             (!('senderPhone' in data) || (data.senderPhone is string && data.senderPhone.size() <= 30)) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 30 &&
             data.cityArea is string && data.cityArea.size() >= 1 && data.cityArea.size() <= 80 &&
             data.addressDetails is string && data.addressDetails.size() <= 250 &&
             data.notes is string && data.notes.size() <= 300 &&
             (!('packageImageBase64' in data) || (data.packageImageBase64 is string && data.packageImageBase64.size() <= 350000)) &&
             data.itemPriceIqd is int && data.itemPriceIqd >= 0 && data.itemPriceIqd <= 1000000000 &&
             data.deliveryFeeIqd is int && data.deliveryFeeIqd >= 0 && data.deliveryFeeIqd <= 100000000 &&
             data.totalAmountIqd is int && data.totalAmountIqd >= 0 && data.totalAmountIqd <= 1100000000 &&
             data.totalAmountIqd == data.itemPriceIqd + data.deliveryFeeIqd &&
             data.status is string && data.status in ['PENDING', 'ASSIGNED', 'ON_THE_WAY', 'DELIVERED', 'RETURNED'] &&
             data.returnReason is string && data.returnReason.size() <= 200 &&
             data.assignedDriverId is string && data.assignedDriverId.size() <= 128 &&
             data.assignedDriverName is string && data.assignedDriverName.size() <= 80 &&
             data.isSettled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCashSettlement(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.companyCode is string && data.companyCode == 'DXP_POST' &&
             data.driverId is string && data.driverId.size() >= 1 && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 80 &&
             data.ordersCount is int && data.ordersCount >= 1 && data.ordersCount <= 500 &&
             data.itemPriceTotalIqd is int && data.itemPriceTotalIqd >= 0 && data.itemPriceTotalIqd <= 1000000000 &&
             data.deliveryFeeTotalIqd is int && data.deliveryFeeTotalIqd >= 0 && data.deliveryFeeTotalIqd <= 100000000 &&
             data.totalSettledCashIqd is int && data.totalSettledCashIqd >= 0 && data.totalSettledCashIqd <= 1100000000 &&
             data.totalSettledCashIqd == data.itemPriceTotalIqd + data.deliveryFeeTotalIqd &&
             data.notes is string && data.notes.size() <= 250 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Collection: /staff/{staffId} (Unlimited Admins via DXP + DXPPOST credentials & Delivery Drivers)
    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && (
        staffId == request.auth.uid ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        existing().companyCode == 'DXP_POST'
      );

      allow create: if isSignedIn() &&
        isValidId(staffId) &&
        incoming().keys().hasAll([
          'ownerUid', 'companyCode', 'name', 'phone', 'role',
          'vehicleInfo', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'name', 'phone', 'email', 'role',
          'adminUsername', 'adminCode', 'vehicleInfo', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidStaffMember(incoming()) &&
        incoming().ownerUid == request.auth.uid && (
          // Self-registration as DRIVER, or unlocking OWNER with DXP + DXPPOST, or Admin creating staff
          (staffId == request.auth.uid && incoming().role == 'DRIVER') ||
          (staffId == request.auth.uid && incoming().role == 'OWNER' && hasValidAdminSecretCode(incoming())) ||
          isAdmin()
        );

      allow update: if isSignedIn() &&
        isValidId(staffId) &&
        isValidStaffMember(incoming()) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'name', 'phone', 'email', 'role',
          'adminUsername', 'adminCode', 'vehicleInfo', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().companyCode == existing().companyCode &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Admin can manage all staff fields
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'email', 'role', 'adminUsername', 'adminCode', 'vehicleInfo', 'active', 'updatedAt'
            ])
          ) ||
          // Action 2: Any user can unlock OWNER role on their own profile by supplying DXP + DXPPOST
          (staffId == request.auth.uid &&
            incoming().role == 'OWNER' &&
            hasValidAdminSecretCode(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'email', 'role', 'adminUsername', 'adminCode', 'vehicleInfo', 'active', 'updatedAt'
            ])
          ) ||
          // Action 3: Driver can update own contact/vehicle info, cannot escalate role without DXPPOST code
          (staffId == request.auth.uid &&
            incoming().role == existing().role &&
            incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'email', 'vehicleInfo', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(staffId) &&
        isAdmin();
    }

    // 5. Collection: /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        existing().ownerUid == request.auth.uid ||
        existing().assignedDriverId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        existing().assignedDriverId == request.auth.uid ||
        (existing().companyCode == 'DXP_POST' && isAdmin())
      );

      // Both Admins AND Drivers can create orders/packages (with photo, senderPhone, customerPhone, location)
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        incoming().keys().hasAll([
          'ownerUid', 'companyCode', 'trackingCode', 'senderName',
          'customerName', 'customerPhone', 'cityArea', 'addressDetails',
          'notes', 'itemPriceIqd', 'deliveryFeeIqd', 'totalAmountIqd',
          'status', 'returnReason', 'assignedDriverId', 'assignedDriverName',
          'isSettled', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'trackingCode', 'senderName', 'senderPhone',
          'customerName', 'customerPhone', 'cityArea', 'addressDetails',
          'notes', 'packageImageBase64', 'itemPriceIqd', 'deliveryFeeIqd', 'totalAmountIqd',
          'status', 'returnReason', 'assignedDriverId', 'assignedDriverName',
          'isSettled', 'createdAt', 'updatedAt'
        ]) &&
        isValidDeliveryOrder(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().isSettled == false && (
          isAdmin() ||
          incoming().assignedDriverId == request.auth.uid
        );

      allow update: if isSignedIn() &&
        isValidId(orderId) &&
        isValidDeliveryOrder(incoming()) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'trackingCode', 'senderName', 'senderPhone',
          'customerName', 'customerPhone', 'cityArea', 'addressDetails',
          'notes', 'packageImageBase64', 'itemPriceIqd', 'deliveryFeeIqd', 'totalAmountIqd',
          'status', 'returnReason', 'assignedDriverId', 'assignedDriverName',
          'isSettled', 'createdAt', 'updatedAt'
        ]) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().companyCode == existing().companyCode &&
        incoming().trackingCode == existing().trackingCode &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Admin full order management, driver assignment & accounting settlement
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'senderName', 'senderPhone', 'customerName', 'customerPhone', 'cityArea',
              'addressDetails', 'notes', 'packageImageBase64', 'itemPriceIqd', 'deliveryFeeIqd',
              'totalAmountIqd', 'status', 'returnReason', 'assignedDriverId',
              'assignedDriverName', 'isSettled', 'updatedAt'
            ])
          ) ||
          // Action 2: Assigned Driver can update delivery status, returnReason, or package photo on unsettled orders
          ((existing().assignedDriverId == request.auth.uid || existing().ownerUid == request.auth.uid) &&
            existing().isSettled == false &&
            incoming().isSettled == false &&
            incoming().assignedDriverId == existing().assignedDriverId &&
            incoming().assignedDriverName == existing().assignedDriverName &&
            incoming().itemPriceIqd == existing().itemPriceIqd &&
            incoming().deliveryFeeIqd == existing().deliveryFeeIqd &&
            incoming().totalAmountIqd == existing().totalAmountIqd &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'returnReason', 'packageImageBase64', 'notes', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(orderId) &&
        isAdmin();
    }

    // 6. Collection: /settlements/{settlementId} (Cash & Accounting Records)
    match /settlements/{settlementId} {
      allow get: if isSignedIn() && isValidId(settlementId) && (
        existing().driverId == request.auth.uid ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().driverId == request.auth.uid ||
        existing().ownerUid == request.auth.uid ||
        (existing().companyCode == 'DXP_POST' && isAdmin())
      );

      // Only Admins can create, update, or delete cash/accounting settlement records
      allow create: if isSignedIn() &&
        isValidId(settlementId) &&
        incoming().keys().hasAll([
          'ownerUid', 'companyCode', 'driverId', 'driverName',
          'ordersCount', 'itemPriceTotalIqd', 'deliveryFeeTotalIqd',
          'totalSettledCashIqd', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'driverId', 'driverName',
          'ordersCount', 'itemPriceTotalIqd', 'deliveryFeeTotalIqd',
          'totalSettledCashIqd', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidCashSettlement(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(settlementId) &&
        isValidCashSettlement(incoming()) &&
        incoming().keys().hasOnly([
          'ownerUid', 'companyCode', 'driverId', 'driverName',
          'ordersCount', 'itemPriceTotalIqd', 'deliveryFeeTotalIqd',
          'totalSettledCashIqd', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().companyCode == existing().companyCode &&
        incoming().driverId == existing().driverId &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(settlementId) &&
        isAdmin();
    }
  }
}
